#include <stdio.h>
#include <stdlib.h>
#include <string.h>

int next_permutation(int n, char **s)
{
    // Step 1: Find the largest index k such that s[k] < s[k+1]
    int k = -1;
    for (int i = n - 2; i >= 0; i--)
    {
        if (strcmp(s[i], s[i + 1]) < 0)
        {
            k = i;
            break;
        }
    }

    // If no such index exists, this is the last permutation
    if (k == -1)
        return 0;

    // Step 2: Find the largest index l > k such that s[l] > s[k]
    int l = -1;
    for (int i = n - 1; i > k; i--)
    {
        if (strcmp(s[i], s[k]) > 0)
        {
            l = i;
            break;
        }
    }

    // Step 3: Swap s[k] and s[l]
    char *temp = s[k];
    s[k] = s[l];
    s[l] = temp;

    // Step 4: Reverse from s[k+1] to end
    int i = k + 1, j = n - 1;
    while (i < j)
    {
        char *temp2 = s[i];
        s[i] = s[j];
        s[j] = temp2;
        i++;
        j--;
    }

    return 1;
}

int main()
{
    char **s;
    int n;
    scanf("%d", &n);

    s = calloc(n, sizeof(char*));

    for (int i = 0; i < n; i++)
    {
        s[i] = calloc(11, sizeof(char));
        scanf("%s", s[i]);
    }

    do
    {
        for (int i = 0; i < n; i++)
            printf("%s%c", s[i], i == n - 1 ? '\n' : ' ');
    } while (next_permutation(n, s));

    for (int i = 0; i < n; i++)
        free(s[i]);

    free(s);
    return 0;
}
